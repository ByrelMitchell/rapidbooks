# RapidBooks server. Installed by deploy/install.sh as /etc/systemd/system/rapidbooks.service.
# Logs: journalctl -u rapidbooks -f
# The backup folder (RAPIDBOOKS_BACKUP_DIR) is made writable by a drop-in that
# install.sh writes: /etc/systemd/system/rapidbooks.service.d/backup-dir.conf

[Unit]
Description=RapidBooks bookkeeping server
Documentation=file:///opt/rapidbooks/docs/DEPLOY.md
# Wait for the network and for network mounts (the backup folder may be one).
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=simple
User=rapidbooks
Group=rapidbooks
WorkingDirectory=/opt/rapidbooks
EnvironmentFile=/etc/rapidbooks.env
# tsx runs the TypeScript server directly, in this one process (so SIGTERM reaches it).
ExecStart=/usr/bin/env node --import tsx packages/server/src/main.ts
# On stop: finish requests, wait for a running backup, checkpoint and close the database.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
UMask=0027

# The data folder /var/lib/rapidbooks (created and owned by the rapidbooks user).
StateDirectory=rapidbooks
StateDirectoryMode=0750
ReadWritePaths=/var/lib/rapidbooks

# Hardening: everything else is read-only or hidden.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# Not MemoryDenyWriteExecute: Node's JIT needs writable+executable memory.
# A port below 1024 (e.g. 443) would need: AmbientCapabilities=CAP_NET_BIND_SERVICE
# and CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
