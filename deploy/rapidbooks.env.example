# /etc/rapidbooks.env -- settings for the RapidBooks server (read by systemd:
# EnvironmentFile= in rapidbooks.service). After changing anything here:
#     sudo systemctl restart rapidbooks
# Lines starting with # are comments. No quotes needed around values.

# ---- Network ---------------------------------------------------------------

# Address to listen on. 0.0.0.0 = every network interface (needed for other
# computers on the LAN to connect). 127.0.0.1 = this computer only.
# RapidBooks refuses to listen on anything but 127.0.0.1 until a password is set.
HOST=0.0.0.0

# TCP port. Open it in the firewall (see docs/DEPLOY.md).
PORT=3001

# ---- Data ------------------------------------------------------------------

# The database file. Its folder is the "data folder": auth.json, sessions.json and
# (by default) backups/ live next to it.
RAPIDBOOKS_DB=/var/lib/rapidbooks/rapidbooks.db

# ---- Backups ---------------------------------------------------------------

# Where backups go. Default: backups/ in the data folder -- but that is on the
# same disk as the database, so if that disk dies the backups die with it.
# Point this at ANOTHER COMPUTER's shared folder mounted on this machine
# (NFS or SMB, see docs/DEPLOY.md). When this is set, the folder must already
# exist: RapidBooks will not create it, so a missing mount shows up as a failed
# backup instead of backups silently piling up on the local disk.
# install.sh adds this folder to the service's ReadWritePaths for you.
#RAPIDBOOKS_BACKUP_DIR=/mnt/rapidbooks-backup

# Time of the nightly backup, 24-hour local time. "off" disables it (backups can
# still be made from File > Back Up). If the server was off at that time, it
# backs up shortly after starting whenever the last backup is over 26 hours old.
RAPIDBOOKS_BACKUP_TIME=02:00

# ---- Login -----------------------------------------------------------------

# The password file (a scrypt hash, never the password itself). Set it with
#     sudo rapidbooks-admin set-password
# Default: auth.json in the data folder.
#RAPIDBOOKS_AUTH_FILE=/var/lib/rapidbooks/auth.json

# Where login sessions are kept so a restart doesn't log her out.
# Default: sessions.json in the data folder.
#RAPIDBOOKS_SESSION_FILE=/var/lib/rapidbooks/sessions.json

# Set to 1 to allow running WITHOUT a password on a non-loopback HOST.
# Anyone on the network could then open the books. Not recommended.
#RAPIDBOOKS_NO_AUTH=1

# Without a password the server answers only to IP addresses, localhost and this
# machine's own name (a defence against web pages that rebind their name to it).
# Other names it should answer to, comma-separated:
#RAPIDBOOKS_ALLOWED_HOSTS=books.lan

# ---- HTTPS (optional, recommended) -------------------------------------------

# With both set, the server speaks HTTPS instead of HTTP. Needed for the browser
# to give the app Ctrl+W / Ctrl+N / Ctrl+T in full screen (Keyboard Lock only works
# in a secure context). Make them with deploy/make-cert.sh. The files must be
# readable by the rapidbooks user.
#RAPIDBOOKS_TLS_CERT=/etc/rapidbooks/tls/server.crt
#RAPIDBOOKS_TLS_KEY=/etc/rapidbooks/tls/server.key

# ---- Web app ---------------------------------------------------------------

# The built web app (npm run build). Default: packages/web/dist in the app folder.
#RAPIDBOOKS_WEB_DIST=/opt/rapidbooks/packages/web/dist

# ---- E-mail (see docs/EMAIL.md) ----------------------------------------------

# SMTP settings can live in a JSON file or here; these win over the file.
#RAPIDBOOKS_SMTP_FILE=/etc/rapidbooks/smtp.json
#RAPIDBOOKS_SMTP_HOST=smtp.example.com
#RAPIDBOOKS_SMTP_PORT=587
#RAPIDBOOKS_SMTP_SECURE=false
#RAPIDBOOKS_SMTP_USER=office@example.com
#RAPIDBOOKS_SMTP_PASSWORD=
#RAPIDBOOKS_SMTP_FROM=Acme Machine <office@example.com>
#RAPIDBOOKS_SMTP_BCC_SELF=true
